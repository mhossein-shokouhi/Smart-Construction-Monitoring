# Copy to each Pi as /etc/pi-ip-announce.env (one file per device, different PI_ID).
#
#   sudo cp config.example.env /etc/pi-ip-announce.env
#   sudo nano /etc/pi-ip-announce.env

PI_ID=0
REGISTRY_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
REGISTRY_SECRET=your-long-random-secret
NETWORK_INTERFACE=wlan0
ANNOUNCE_INTERVAL_SEC=60
